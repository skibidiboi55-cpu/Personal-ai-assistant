# Choose: openrouter | openai-compatible | ollama
AI_PROVIDER=openrouter

# OpenRouter: https://openrouter.ai/
OPENROUTER_API_KEY=

# OpenAI-compatible providers can use their own API endpoint/key.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=

# Model ID. For OpenRouter this is an OpenRouter model slug.
AI_MODEL=google/gemini-2.5-flash

# Optional display metadata sent to OpenRouter.
APP_URL=http://localhost:3000
APP_NAME=Personal AI Assistant
