# Choose: opencode | openrouter | openai-compatible | ollama
# OpenCode uses the provider account already signed in with `opencode auth login`.
AI_PROVIDER=opencode

# OpenRouter: https://openrouter.ai/
OPENROUTER_API_KEY=

# OpenAI-compatible providers can use their own API endpoint/key.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=

# Optional model ID. Leave blank to use the OpenCode CLI's configured default.
AI_MODEL=

# Optional display metadata sent to OpenRouter.
APP_URL=http://localhost:3000
APP_NAME=Personal AI Assistant
